# Ollama configuration (no API keys required for local use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Positive integers only. Default output preserves original behavior.
OLLAMA_NUM_PREDICT=1024
# Omit OLLAMA_NUM_CTX to preserve Ollama's context default.
# OLLAMA_NUM_CTX=2048
# Low-memory trial: set OLLAMA_MODEL=llama3.2:1b,
# OLLAMA_NUM_PREDICT=128 and OLLAMA_NUM_CTX=2048 in the app process.
# This file is not automatically loaded. RAM/context fit must be checked.

# Optional Groq Free cloud generation (these variables must be in the app process).
# Keep your Groq organization on Free; do not enable paid billing.
# GENERATION_PROVIDER=groq
# GROQ_FREE_PLAN_CONFIRMED=1
# GROQ_API_KEY=<configure locally; never commit>
# GROQ_MAX_COMPLETION_TOKENS=1024
# Fixed model: openai/gpt-oss-20b. No automatic retry/provider fallback.
# Optional low-memory CPU embeddings. Uses the same MiniLM model, 256-token
# truncation, mean pooling and normalized 384-dimensional embeddings.
# EMBEDDING_BACKEND=onnx
# ONNX_MODEL_PATH=absolute-path-to-verified-model.onnx
# ONNX_TOKENIZER_PATH=absolute-path-to-matching-tokenizer.json
